# The corpus. Regenerated by cron on the VM; pulled down to adjudicate.
# Not in git: it is data, it changes daily, and it would make every commit a
# binary diff.
*.db
*.db-journal
*.db-wal

# Exported scoring inputs — derived from the database, regenerate with
# `python3 store.py export`
model_labels.csv
human_labels.csv
corpus_labels.csv

# Secrets. The API key lives here and must never be committed.
.env
kdb.env

# Build output — regenerated every run
index.html

__pycache__/
*.pyc
.venv/
venv/
